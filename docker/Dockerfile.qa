FROM python:3.11-slim
WORKDIR /app
RUN pip config set global.index-url https://pypi.org/simple
COPY python/qa-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY python/qa-service/config/skills /app/config/skills
COPY python/qa-service/ .
ENV EVALUATION_SKILLS_DIR=/app/config/skills \
    LOG_DIR=/app/logs \
    LOG_ENV=prod \
    LOG_LEVEL=INFO \
    LOG_ROTATION_MODE=size
RUN test -s /app/config/skills/README.md \
    && test "$(find /app/config/skills -mindepth 2 -maxdepth 2 -name SKILL.md -type f | wc -l)" -eq 30 \
    && python -c "from agents.skill_catalog import load_catalog; catalog = load_catalog(); assert len(catalog['skills']) == 30; print('Validated Skill catalog:', len(catalog['skills']))"
RUN mkdir -p /app/logs
EXPOSE 10253
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:10253/health', timeout=3)"
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "10253"]
