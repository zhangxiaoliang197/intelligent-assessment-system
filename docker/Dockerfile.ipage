FROM python:3.11-slim
WORKDIR /app
RUN pip config set global.index-url https://pypi.org/simple
COPY python/interactive-page-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY python/interactive-page-service/ .
ENV LOG_DIR=/app/logs \
    LOG_ENV=prod \
    LOG_LEVEL=INFO \
    IPAGE_DB=/app/data/ipage_pages.sqlite3
RUN mkdir -p /app/logs /app/data
EXPOSE 10259
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import json,urllib.request; data=json.load(urllib.request.urlopen('http://127.0.0.1:10259/ipage/health',timeout=3)); health=data.get('data',{}); assert data.get('success') and health.get('status') in ('healthy','degraded')"
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "10259"]
