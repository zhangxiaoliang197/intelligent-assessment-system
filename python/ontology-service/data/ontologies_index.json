        "color": "#91cc75",
        "property_schema": [
          {
            "name": "分类依据",
            "category": "descriptive",
            "data_type": "string",
            "unit": "",
            "required": false,
            "description": "按机器人工作的空间环境划分"
          }
        ],
        "source_snippet": "根据机器人的使用空间，机器人可分为地面／地下机器人、水面／水下机器人、空中机器人、空间机器人和其他使用空间机器人。",
