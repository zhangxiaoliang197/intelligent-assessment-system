      },
      {
        "id": "concept_9fd82b55",
        "ontology_id": "ont_7d2cc296",
        "name": "运动方式",
        "description": "根据机器人移动或运动实现方式进行分类的维度。",
        "color": "#91cc75",
        "property_schema": [
          {
            "name": "分类依据",
            "category": "descriptive",
            "data_type": "string",
            "unit": "",
            "required": false,
            "description": "按机器人实现运动的方式划分"
          }
        ],
        "source_snippet": "根据机器人的运动方式，机器人可分为轮式机器人、足腿式机器人、履带式机器人、蠕动式机器人、浮游式机器人、潜游式机器人、飞行式机器人和其他运动方式机器人。",
        "parent_entity_type_id": null,
        "parent_entity_type_name": null,
        "create_time": "2026-08-11 16:52:30.921177",
        "update_time": "2026-08-11 16:52:30.921177"
      },
      {
        "id": "concept_e0fd9e65",
        "ontology_id": "ont_7d2cc296",
        "name": "使用空间",
