        "name": "应用领域",
        "description": "根据机器人应用的行业或场所领域进行分类的维度。",
        "color": "#91cc75",
        "property_schema": [
          {
            "name": "分类依据",
            "category": "descriptive",
            "data_type": "string",
            "unit": "",
            "required": false,
            "description": "按机器人应用场所及行业领域划分"
          }
        ],
        "source_snippet": "根据机器人的应用领域，机器人可分为工业机器人、个人／家用服务机器人、公共服务机器人、特种机器人和其他应用领域机器人。",
        "parent_entity_type_id": null,
        "parent_entity_type_name": null,
