{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/main.ts",
    "src/env.d.ts",
    "src/router/index.ts",
    "src/services/causalApi.ts",
    "src/stores/ontology.ts",
    "src/types/causal.ts",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/**/*.tsx",
    "src/**/*.jsx",
    "src/hooks/**"
  ]
}
