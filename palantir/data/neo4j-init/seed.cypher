// ============================================================
// AEGIS – Neo4j Initialization Script (Expanded)
// Water Supply Sabotage Detection – Seed Data
// 20 Facilities · 100 Persons · 8 Organizations
// 6 Sabotage Scenarios + Noise Events
// ============================================================

// --- Constraints & Indexes ---
CREATE CONSTRAINT facility_facilityid IF NOT EXISTS FOR (n:Facility) REQUIRE n.facilityId IS UNIQUE;
CREATE CONSTRAINT person_personid IF NOT EXISTS FOR (n:Person) REQUIRE n.personId IS UNIQUE;
CREATE CONSTRAINT event_eventid IF NOT EXISTS FOR (n:Event) REQUIRE n.eventId IS UNIQUE;
CREATE CONSTRAINT sensor_sensorid IF NOT EXISTS FOR (n:Sensor) REQUIRE n.sensorId IS UNIQUE;
CREATE CONSTRAINT asset_assetid IF NOT EXISTS FOR (n:Asset) REQUIRE n.assetId IS UNIQUE;
CREATE CONSTRAINT organization_orgid IF NOT EXISTS FOR (n:Organization) REQUIRE n.orgId IS UNIQUE;
CREATE CONSTRAINT riskcase_caseid IF NOT EXISTS FOR (n:RiskCase) REQUIRE n.caseId IS UNIQUE;
CREATE CONSTRAINT location_locationid IF NOT EXISTS FOR (n:Location) REQUIRE n.locationId IS UNIQUE;
CREATE CONSTRAINT document_docid IF NOT EXISTS FOR (n:Document) REQUIRE n.docId IS UNIQUE;
CREATE INDEX event_timestamp IF NOT EXISTS FOR (e:Event) ON (e.timestamp);
CREATE INDEX event_type IF NOT EXISTS FOR (e:Event) ON (e.eventType);
CREATE INDEX facility_name IF NOT EXISTS FOR (f:Facility) ON (f.name);
CREATE INDEX person_name IF NOT EXISTS FOR (p:Person) ON (p.name);

