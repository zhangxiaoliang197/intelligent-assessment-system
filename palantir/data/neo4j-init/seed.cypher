CREATE (doc_DOC_0026:Document:MaintenanceReport {docId: 'DOC-0026', docType: 'maintenance_report', title: 'Maintenance Report – Chlorine dosing pump at Nodo Distribución Parla', sourceFile: 'MR_FAC-017_20252642.pdf', classification: 'INTERNAL', timestamp: datetime('2025-11-20T13:18:16.821872'), contentPreview: '## Maintenance Report  **Work Order:** WO-2026549 **Technician:** Enrique Muñoz **Company:** TechPipe Solutions SL **Facility:** Nodo Distribución Parla **Date:** 2025-10-05 **System:** Chlorine dosing pump  ### Work Performed Installed new SCADA patch (CVE-2025-4421 mitigation). Rebooted system. Verified all I/O points.  ### Findings Electrical connections showed signs of overheating. Tightened and applied thermal paste.  ### Parts Replaced - Pressure transducer PT-3000 - Pressure transducer PT'})
