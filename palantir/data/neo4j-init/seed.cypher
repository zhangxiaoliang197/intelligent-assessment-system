CREATE (doc_DOC_0028:Document:MaintenanceReport {docId: 'DOC-0028', docType: 'maintenance_report', title: 'Maintenance Report – Pressure regulator at Estación Bombeo Fuenlabrada', sourceFile: 'MR_FAC-008_20259562.pdf', classification: 'INTERNAL', timestamp: datetime('2026-01-17T07:08:42.426644'), contentPreview: '## Maintenance Report  **Work Order:** WO-2025480 **Technician:** Youssef Kuznetsov **Company:** TechPipe Solutions SL **Facility:** Estación Bombeo Fuenlabrada **Date:** 2026-01-06 **System:** Pressure regulator  ### Work Performed Replaced worn impeller seals. Recalibrated flow rate to 145 m³/h. Tested emergency shutoff.  ### Findings Minor wear detected – scheduled for next quarter.  ### Parts Replaced - Fuse 10A 500V HRC - Solenoid valve SV-12  ### Anomalies Noted Found an unregistered SIM c'})
