# ============================================================
# 智能评估系统 - 环境变量模板
# ------------------------------------------------------------
# 复制本文件为 .env 并填入实际值：
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows)
#
# .env 文件应被 .gitignore 忽略，不会提交到版本库。
# 切勿在 .env 中填写生产环境真实密码后提交。
# ============================================================

# ─── admin-service (Java) ───
SERVER_PORT=10258

# ─── 元数据库类型: h2 | mysql | postgresql ───
DB_TYPE=mysql

# ─── MySQL 连接 ───
# MYSQL_PASSWORD 需与你的 MySQL 实际密码一致（application.yml 默认值为 root）
# 本地开发若密码非 root 请改为实际值；若为空密码则留空
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=assessment
MYSQL_USER=root
MYSQL_PASSWORD=root

# 以下为 Spring Boot admin-service 所需的完整路径变量（与 .env 保持一致）
DB_MYSQL_HOST=localhost
DB_MYSQL_PORT=3306
DB_MYSQL_DATABASE=assessment
DB_MYSQL_USER=root
DB_MYSQL_PASSWORD=root

# ─── PostgreSQL 连接 ───
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=assessment
PG_USER=postgres
PG_PASSWORD=

# ─── Python 服务间调用地址 ───
ADMIN_SERVICE_URL=http://localhost:10258
KNOWLEDGE_SERVICE_URL=http://localhost:10252
QA_SERVICE_URL=http://localhost:10253
EVALUATION_API_URL=http://localhost:10253
ONTOLOGY_SERVICE_URL=http://localhost:10256

# ─── 态势图 Skill 治理数据（自定义 Skill / 版本 / 收藏 / 使用记录）───
# 本地默认写入 python/situation-service/data；Docker 中由持久化卷覆盖。
SITUATION_SKILL_DB=data/situation_skills.sqlite3
# 内置态势 Skill 的在线 Markdown 修改目录；Docker 中由 situation-data 卷持久化。
SITUATION_SKILL_MD_OVERRIDE_DIR=data/situation-skill-markdown-overrides

# ─── 评估分析 Skill Markdown 在线编辑 ───
# 内置目录保持只读，管理员在线修改持久化到该覆盖目录；Docker 已映射到 qa-data 卷。
EVALUATION_SKILL_MD_OVERRIDE_DIR=data/skill-markdown-overrides

# ─── 大模型配置 ───
LLM_API_URL=http://localhost:8000/v1
LLM_API_KEY=

# ─── 对话上下文轮数 ───
QA_CONTEXT_ROUNDS=5
INDICATOR_CONTEXT_ROUNDS=5

# ─── 统一日志配置 ───
# LOG_ENV: dev | prod （dev 输出彩色控制台+DEBUG 文件；prod 输出 JSON+INFO 按日轮转）
# LOG_ENV 同时决定 admin-service 的 Spring profile（logback-spring.xml 用 dev/prod 切换日志策略）
# 本地开发保持 dev 即可，无需单独设 SPRING_PROFILES_ACTIVE；start.ps1 会自动从 LOG_ENV 推导注入
LOG_ENV=dev
# LOG_LEVEL: 日志级别（DEBUG/INFO/WARN/ERROR）
LOG_LEVEL=INFO
# LOG_RETENTION_DAYS: 生产环境日志保留天数（默认 14）
LOG_RETENTION_DAYS=14
# LOG_MAX_SIZE_MB: 单个日志文件最大体积 MB（按大小轮转时生效，默认 100）
LOG_MAX_SIZE_MB=100
# LOG_ROTATION_MODE: time | size （默认 time；qa-service 等高频服务建议 size）
# LOG_DIR 不在此配置，由 Dockerfile（/app/logs）或本地默认（项目根/logs/{service}）决定
